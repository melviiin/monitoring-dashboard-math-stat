# Salin file ini jadi ".env" lalu isi sesuai MySQL Workbench lokal lo.
# JANGAN commit file ".env" ke git — cuma ".env.example" ini yang boleh.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=12345678
DB_NAME=dashboard_stat_math

# Port tempat backend API ini jalan (dashboard.html akan fetch ke sini)
PORT=5000

# Kalau dashboard.html dibuka lewat Live Server / file:// / port lain,
# tambahin originnya di sini (pisah koma). Default sudah cover kasus umum.
CORS_ORIGIN=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,null
